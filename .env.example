# ==============================================================================
# VEKTOR STUDIO - ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================
# Copy this file to .env.local and fill in your credentials:
#   cp .env.example .env.local

# ------------------------------------------------------------------------------
# Clerk Authentication
# Obtain from https://dashboard.clerk.com
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ------------------------------------------------------------------------------
# Daytona Sandboxes
# Obtain from https://app.daytona.io
# ------------------------------------------------------------------------------
DAYTONA_API_KEY=your_daytona_api_key
DAYTONA_SERVER_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# ------------------------------------------------------------------------------
# Trigger.dev Background Agent Worker
# Obtain from https://cloud.trigger.dev
# ------------------------------------------------------------------------------
TRIGGER_SECRET_KEY=tr_dev_your_trigger_secret_key

# ------------------------------------------------------------------------------
# Neon PostgreSQL Database (Drizzle ORM)
# Obtain from https://console.neon.tech
# DATABASE_URL is pooled connection, DATABASE_URL_UNPOOLED is direct for migrations
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# LLM Providers (Configure whichever providers you plan to use)
# ------------------------------------------------------------------------------

# Anthropic Claude (claude-opus-5, claude-sonnet-5, claude-haiku-4-5)
# Obtain from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI (gpt-4o, gpt-4o-mini, o3-mini)
# Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Google Gemini (gemini-2.5-pro, gemini-2.5-flash)
# Obtain from https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy...
# GOOGLE_API_KEY=AIzaSy... # Alternative key name supported by @ai-sdk/google

# OpenCode Zen (OpenAI-compatible adapter: opencode-zen, opencode-zen-fast)
# Obtain from https://opencode.ai
OPENCODE_ZEN_API_KEY=zen-...
OPENCODE_ZEN_BASE_URL=https://zen.opencode.ai/v1
# OPENCODE_ZEN_MODEL=claude-3-7-sonnet # Optional model override for 'opencode-zen'
# OPENCODE_ZEN_FAST_MODEL=gpt-4o-mini # Optional model override for 'opencode-zen-fast'

# ------------------------------------------------------------------------------
# Sentry & Observability (Optional)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=your-sentry-project
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ENVIRONMENT=development
